# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
# [T-aojit-restore] original signed Alpine packages bundled with the iOS app
!src/ios/AOJITRestore/*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# [LOSFER] The debug signing key is deliberately tracked: every automated
# build (local or CI) must produce the SAME signature so a new APK installs
# over the previous one. This is a public debug key, not a store signing key.
!src/android/signing/losfer-debug.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# iOS
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)
deps/alpine/

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.
deps/ffmpeg-6.1.2/
# Its Simulator build copy (build_ffmpeg.sh --simulator).
deps/ffmpeg-6.1.2-iphonesimulator/

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

src-bak/
src/android/app/src/main/assets/bashism/

# Xcode debugger state (breakpoints) — personal dev state, never track.
# "**/" because a pattern with an inner slash is anchored to this directory
# and never matched src/ios/Minis.xcodeproj/xcshareddata/xcdebugger/.
**/xcshareddata/xcdebugger/

# Python bytecode from the test/build scripts
__pycache__/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# Debug-only skill assets staged by scripts/gen_debug_skill_android.sh from
# .claude/skills/debug-server/; regenerated on every debug build.
src/android/app/src/debug/assets/debug-skill/

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_proot.sh, deps/build_lame.sh,
# deps/prepare_alpine_rootfs.sh and docs for the build order.
src/android/app/src/main/assets/proot-aarch64
src/android/app/src/main/assets/alpine-minirootfs.tar.gz
src/android/app/src/main/jniLibs/arm64-v8a/*.so
# The two proot ELF loaders are TRACKED, as an exception to the rule above.
# They are vendored Termux builds (proot 5.1.107-70) whose Android-specific
# loader patches our deps/proot fork does not carry; pairing the fork-built
# loader with our proot SEGVs the guest on some ROMs (OnePlus 7 Pro /
# crDroid 12.11: "vpid 1: terminated with signal 11"), and the exact Termux
# deb has been rotated out of their repo — these bytes cannot be re-downloaded
# or rebuilt from anything in this tree. See deps/build_proot.sh.
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader.so
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader32.so
deps/lame-build/
deps/lame-build-iphonesimulator/
deps/lame-3.100-iphonesimulator/
deps/lame-3.100/**/.libs/

# LAME autotools output (./configure writes absolute build paths into these)
deps/lame-3.100/**/Makefile
deps/lame-3.100/config.status
deps/lame-3.100/config.h
deps/lame-3.100/libtool
deps/lame-3.100/**/stamp-h1
deps/lame-3.100/**/*.la
deps/lame-3.100/**/*.lai
deps/lame-3.100/**/.libs/
deps/lame-3.100/**/.deps/

# [LOSFER] Release packages staged by scripts/build_release.sh; they are
# uploaded to GitHub Releases, never committed.
dist/

# [LOSFER] rclone.aar (~15MB, built by deps/build_rclone_android.sh) is
# deliberately TRACKED here. Upstream ignores it as a build artifact, but the
# automated release workflow runs on a clean runner with no Go/gomobile cache;
# tracking the AAR built from the committed Go sources keeps every release
# build reproducible and removes a whole toolchain (Go + gomobile + NDK
# cross-compile) from the release path. Rebuild it with
# deps/build_rclone_android.sh whenever deps/rclone-mobile changes.

# [T-ios-aojit] AOJIT images: hundreds of MB of assembly, kept out of git
# (see deps/aot/README.md). The README and workloads are tracked.
deps/aot/*.S
deps/aot/.build/
deps/aot/.build-iphonesimulator/
